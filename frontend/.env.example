# JWT Configuration
AUTH_BRIDGE_SECRET=<shared_secret_for_backend_token_bridge_or_match_nextauth_secret>

# Google OAuth
GOOGLE_CLIENT_ID=<your google client id>
GOOGLE_CLIENT_SECRET=<your google client secret>

# NextAuth
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXTAUTH_SECRET=<generate_with_openssl_rand_-hex_32>
NEXT_PUBLIC_SENTRY_DSN=<optional for now>
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production

# Sentry 
SENTRY_ORG=<if using source map upload>
SENTRY_PROJECT=<if using source map upload>
SENTRY_AUTH_TOKEN=<if using source map upload>