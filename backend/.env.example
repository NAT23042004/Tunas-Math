# API Configuration
APP_NAME=Toán Socratic API
APP_VERSION=0.1.0
DEBUG=true

# Server Configuration
HOST=0.0.0.0
PORT=8000

# LLM Configuration
# Available providers: anthropic, openai, cohere, azure, qwen, gemini
LLM_PROVIDER=anthropic

# Model examples by provider:
# anthropic: claude-sonnet-4-6, claude-3-5-sonnet-20241022, claude-3-haiku-20240307
# openai: gpt-4, gpt-4-turbo, gpt-3.5-turbo
# cohere: command, command-r-plus
# azure: gpt-4, gpt-35-turbo
# qwen: qwen-turbo, qwen-plus, qwen-max
# gemini: gemini-pro, gemini-1.5-pro, gemini-1.5-flash
LLM_MODEL=claude-sonnet-4-6

# API Key Configuration (choose one):
# Option 1: Generic API key (works for all providers)
LLM_API_KEY=

# Option 2: Provider-specific API keys (used if LLM_API_KEY not set)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
COHERE_API_KEY=
AZURE_API_KEY=
QWEN_API_KEY=
GEMINI_API_KEY=

LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=60

# Database
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/toansc
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.0

# JWT Configuration
JWT_SECRET=your_jwt_secret_here_generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
AUTH_BRIDGE_SECRET=shared_secret_for_nextauth_bridge_or_reuse_nextauth_secret

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# NextAuth
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000
