# API Configuration
APP_NAME=Toán Socratic API
APP_VERSION=0.1.0
DEBUG=true

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LLM Configuration
# Available providers: anthropic, openai, cohere, azure, qwen, gemini
LLM_PROVIDER=anthropic

# Model examples by provider:
# anthropic: claude-sonnet-4-6, claude-3-5-sonnet-20241022, claude-3-haiku-20240307
# openai: gpt-4, gpt-4-turbo, gpt-3.5-turbo
# qwen: qwen-turbo, qwen-plus, qwen-max
# gemini: gemini-pro, gemini-1.5-pro, gemini-1.5-flash
LLM_MODEL=claude-sonnet-4-6

# Generic API key (optional, falls back to provider-specific keys)
LLM_API_KEY=

# Provider-specific API keys (optional, used if LLM_API_KEY not set)
OPENAI_API_KEY=
QWEN_API_KEY=
GEMINI_API_KEY=

LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024

# Database
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/toansc

# JWT Configuration
JWT_SECRET=your_jwt_secret_here_generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# NextAuth
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000